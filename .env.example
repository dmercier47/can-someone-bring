# Copy to .env.local and fill in from your Supabase project (Project Settings).
# .env.local is git-ignored. Never commit real keys.

# Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Project Settings → API Keys → Publishable key (safe for the browser; used for host login later)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY
# Project Settings → API Keys → Secret key (SERVER ONLY — full database access)
SUPABASE_SECRET_KEY=sb_secret_YOUR-KEY
# Resend sending-only key, scoped to the sending domain (resend.com/api-keys). Server only.
RESEND_API_KEY=re_YOUR-KEY
RESEND_FROM="Can Someone Bring <hello@mail.example.com>"
# Connect (top bar) → Session pooler → URI, with your database password filled in.
# Only used by `npm run db:migrate` / `npm run db:seed`.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
